---
source: apollo-router/src/plugins/telemetry/config_new/instruments.rs
description: Custom counter conditions are evaluated when a coprocessor call fails at the supergraph stage
expression: "&metrics.all()"
info:
  telemetry:
    instrumentation:
      instruments:
        default_requirement_level: none
        supergraph:
          with_response_header:
            description: count of responses with x-outcome
            type: counter
            unit: unit
            value: unit
            attributes:
              outcome:
                response_header: x-outcome
            condition:
              exists:
                response_header: x-outcome
          coprocessor_timeouts:
            description: count of requests whose coprocessor call timed out
            type: counter
            unit: unit
            value: unit
            condition:
              eq:
                - request timed out
                - error: reason
---
- name: coprocessor_timeouts
  description: count of requests whose coprocessor call timed out
  unit: unit
  data:
    datapoints:
      - value: 1
        attributes: {}
- name: with_response_header
  description: count of responses with x-outcome
  unit: unit
  data:
    datapoints:
      - value: 1
        attributes:
          outcome: match
