=== one error per element, inside `->map`
    $.rows->map(@.code->withError("bad code"))

  --- include_subgraph_errors: all: true
  data: {"rows":[1,2]}
    message: bad code
    path:    ["rows",0]
    ext:     code = "CONNECTORS_MAPPING_ERROR"
    ext:     connector = {"selectionPath":"rows.0.code","coordinate":"subgraph_name:Query.account[0]"}
    ext:     service = "subgraph_name"

    message: bad code
    path:    ["rows",1]
    ext:     code = "CONNECTORS_MAPPING_ERROR"
    ext:     connector = {"selectionPath":"rows.1.code","coordinate":"subgraph_name:Query.account[0]"}
    ext:     service = "subgraph_name"


