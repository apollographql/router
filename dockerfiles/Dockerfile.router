# Must be declared before any FROM so it can be used in FROM stage selection.
ARG DEBUG_IMAGE=false

# Router tarballs built earlier in a CI pipeline, mounted for
# download_and_validate_router.sh. CI replaces this empty stage by passing
# `--build-context router-artifacts=<dir>`, where <dir> holds one tarball per
# platform and a sha256sums.txt, so a multi-platform build gives each platform
# its own binary. Left empty, the script downloads a release instead.
FROM scratch AS router-artifacts

# This stage runs on the build host's platform, since it only fetches and
# extracts the Router tarball. The script selects the tarball for the target
# platform from TARGETPLATFORM. In a multi-platform build that keeps these steps
# out of QEMU emulation, where they take many times longer.
FROM --platform=$BUILDPLATFORM debian:trixie-slim AS downloader
ARG ROUTER_RELEASE=latest
ARG ARTIFACT_URL=
ARG CIRCLE_TOKEN=
ARG ARTIFACT_URL_SHA256SUM=
# We will use TARGETPLATFORM inside the download_and_validate_router.sh script
# It is set automatically by Docker when doing a buildx build, see:
#  https://docs.docker.com/build/building/multi-platform/
ARG TARGETPLATFORM

RUN \
  apt-get update -y \
  && apt-get install -y \
    curl

# We work in /, and the tarball produces /dist/router after extraction.
WORKDIR /

# Copy and run the router download script
COPY download_and_validate_router.sh /tmp/download_and_validate_router.sh
RUN --mount=type=bind,from=router-artifacts,target=/router-artifacts \
  chmod +x /tmp/download_and_validate_router.sh && /tmp/download_and_validate_router.sh

# Use a multi-stage build to install the debug tools if DEBUG_IMAGE is true
#
# This stage runs on the build host's platform and cross-compiles the tools for
# the target platform. In a multi-platform build that keeps compilation out of
# QEMU emulation, where building these crates takes many times longer.
FROM --platform=$BUILDPLATFORM rust:slim-trixie AS install-debug-tools-true
ARG BUILDARCH
ARG TARGETARCH
# Add the Rust target and, when cross-compiling, the target's GCC as linker
RUN \
  case "${TARGETARCH}" in \
    amd64) echo x86_64-unknown-linux-gnu > /tmp/rust-target ;; \
    arm64) echo aarch64-unknown-linux-gnu > /tmp/rust-target ;; \
    *) echo "Error: Unsupported TARGETARCH '${TARGETARCH}'" >&2; exit 1 ;; \
  esac \
  && rustup target add "$(cat /tmp/rust-target)" \
  && if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
    case "${TARGETARCH}" in \
      amd64) gcc_pkg=gcc-x86-64-linux-gnu linker=x86_64-linux-gnu-gcc ;; \
      arm64) gcc_pkg=gcc-aarch64-linux-gnu linker=aarch64-linux-gnu-gcc ;; \
    esac \
    && apt-get update -y \
    && apt-get install -y "${gcc_pkg}" \
    && rm -rf /var/lib/apt/lists/* \
    && echo "${linker}" > /tmp/rust-linker; \
  fi
# We use the rust addr2line to avoid this error/perf issue https://github.com/iced-rs/iced/issues/2394
RUN \
  target="$(cat /tmp/rust-target)" \
  && if [ -f /tmp/rust-linker ]; then \
    export "CARGO_TARGET_$(echo "${target}" | tr 'a-z-' 'A-Z_')_LINKER=$(cat /tmp/rust-linker)"; \
  fi \
  && cargo install addr2line --locked --features="bin" --target "${target}" \
  && cargo install flamegraph --locked --target "${target}"

FROM rust:slim-trixie AS install-debug-tools-false
# Do nothing

FROM install-debug-tools-${DEBUG_IMAGE} AS install-debug-tools

FROM debian:trixie-slim AS distro
# Build args are declared just before their first use rather than at the top of
# this stage, because a build arg changes the cache key of every RUN step that
# follows its declaration. Declaring DEBUG_IMAGE (and the per-build version
# args) late lets debug and non-debug builds share the layers that come first.
#
# For the same reason, the Router binary is copied in only after the apt steps,
# which then neither wait on the downloader stage nor depend on its output.

# Add a user to run the router as
RUN useradd -m router

# Update apt and install ca-certificates
RUN \
  apt-get update -y \
  && apt-get install -y \
    ca-certificates

WORKDIR /dist

ARG DEBUG_IMAGE=false

# If debug image, install perf and heaptrack and make a data directory
RUN \
  if [ "${DEBUG_IMAGE}" = "true" ]; then \
    apt-get install -y linux-perf heaptrack && \
    mkdir data && \
    chown router data; \
  fi

# Copy the debug tools from the install-debug-tools stage if DEBUG_IMAGE was true.
COPY --from=install-debug-tools /usr/local/cargo/bin/flamegraph* /usr/bin/
COPY --from=install-debug-tools /usr/local/cargo/bin/addr2line* /usr/bin/

# Clean up apt lists
RUN rm -rf /var/lib/apt/lists/*

COPY --from=downloader /dist/router /dist

# Make directories for config and schema
RUN mkdir config schema

# Copy configuration for docker image
COPY router.yaml config

ARG REPO_URL=https://github.com/apollographql/router
ARG BASE_VERSION

LABEL org.opencontainers.image.authors="Apollo Graph, Inc. ${REPO_URL}"
LABEL org.opencontainers.image.source="${REPO_URL}"
LABEL org.opencontainers.image.version="${BASE_VERSION}"

ENV APOLLO_ROUTER_CONFIG_PATH="/dist/config/router.yaml"

# Create a wrapper script to run the router, use exec to ensure signals are handled correctly
RUN \
  echo '#!/bin/bash \
\nset -e \
\n \
\nif [ -f "/usr/bin/heaptrack" ]; then \
\n    exec heaptrack -o /dist/data/$(hostname)/router_heaptrack  /dist/router "$@" \
\nelse \
\n    exec /dist/router "$@" \
\nfi \
' > /dist/router_wrapper.sh

# Make sure we can run our wrapper
RUN chmod 755 /dist/router_wrapper.sh

USER router

# Default executable is the wrapper script
ENTRYPOINT ["/dist/router_wrapper.sh"]
