directive @defer(label: String, if: Boolean! = true) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Person {
  id: ID!
  name: String
  title: String
}

type Query {
  users: [User]
  person(id: ID!): Person
}

type User {
  id: ID!
  manager: Person
  reports: [Person]
}
