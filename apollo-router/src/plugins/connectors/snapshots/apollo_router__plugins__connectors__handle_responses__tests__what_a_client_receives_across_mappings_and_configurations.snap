---
source: apollo-router/src/plugins/connectors/handle_responses.rs
expression: report
---
=== plain field
    status: code->withError("Unrecognized code")

  --- include_subgraph_errors: all: true
  data: {"account":{"status":7}}
    message: Unrecognized code
    path:    ["account","status"]
    ext:     code = "CONNECTORS_MAPPING_ERROR"
    ext:     connector = {"selectionPath":"code","coordinate":"subgraph_name:Query.account[0]"}
    ext:     service = "subgraph_name"


  --- the default, which redacts subgraph errors
  data: {"account":{"status":7}}
  (nothing reported)

  --- redact_message with an allow list
  data: {"account":{"status":7}}
    message: Subgraph errors redacted
    path:    ["account","status"]
    ext:     code = "CONNECTORS_MAPPING_ERROR"
    ext:     service = "subgraph_name"


  --- redact_message with a deny list
  data: {"account":{"status":7}}
    message: Subgraph errors redacted
    path:    ["account","status"]
    ext:     code = "CONNECTORS_MAPPING_ERROR"
    ext:     connector = {"selectionPath":"code","coordinate":"subgraph_name:Query.account[0]"}
    ext:     service = "subgraph_name"


