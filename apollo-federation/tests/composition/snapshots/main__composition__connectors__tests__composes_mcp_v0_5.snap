---
source: apollo-federation/tests/composition/connectors.rs
expression: supergraph.schema().schema().to_string()
---
schema @link(url: "https://specs.apollo.dev/link/v1.0") @link(url: "https://specs.apollo.dev/join/v0.6", for: EXECUTION) @link(url: "https://specs.apollo.dev/connect/v0.5", for: EXECUTION) @join__directive(name: "link", graphs: [QUAKES], args: {url: "https://specs.apollo.dev/connect/v0.5", import: ["@connect", "@source"]}) @join__directive(name: "source", graphs: [QUAKES], args: {name: "quakes", http: {baseURL: "http://localhost:4001"}, mcp: {path: "/mcp"}}) {
  query: Query
}

directive @link(url: String, as: String, for: link__Purpose, import: [link__Import]) repeatable on SCHEMA

directive @join__graph(name: String!, url: String!) on ENUM_VALUE

directive @join__type(graph: join__Graph!, key: join__FieldSet, extension: Boolean! = false, resolvable: Boolean! = true, isInterfaceObject: Boolean! = false) repeatable on OBJECT | INTERFACE | UNION | ENUM | INPUT_OBJECT | SCALAR

directive @join__field(graph: join__Graph, requires: join__FieldSet, provides: join__FieldSet, type: String, external: Boolean, override: String, usedOverridden: Boolean, overrideLabel: String, contextArguments: [join__ContextArgument!]) repeatable on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

directive @join__implements(graph: join__Graph!, interface: String!) repeatable on OBJECT | INTERFACE

directive @join__unionMember(graph: join__Graph!, member: String!) repeatable on UNION

directive @join__enumValue(graph: join__Graph!) repeatable on ENUM_VALUE

directive @join__directive(graphs: [join__Graph!], name: String!, args: join__DirectiveArguments) repeatable on SCHEMA | OBJECT | INTERFACE | FIELD_DEFINITION

enum link__Purpose {
  """
  `SECURITY` features provide metadata necessary to securely resolve fields.
  """
  SECURITY
  """
  `EXECUTION` features provide metadata necessary for operation execution.
  """
  EXECUTION
}

scalar link__Import

enum join__Graph {
  QUAKES @join__graph(name: "quakes", url: "http://quakes")
}

scalar join__FieldSet

scalar join__DirectiveArguments

scalar join__FieldValue

input join__ContextArgument {
  name: String!
  type: String!
  context: String!
  selection: join__FieldValue!
}

type Query @join__type(graph: QUAKES) {
  recentQuakes(limit: Int): [Quake] @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "search_events", arguments: "limit: $args.limit"}, selection: "$.events { id magnitude }"})
  latestQuake: Quake @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "latest_event"}, selection: "id magnitude"})
  quake(id: ID!): Quake @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "get_event", arguments: "event_id: $args.id"}, selection: "id magnitude", entity: true})
  stations: [Station] @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "list_stations"}, selection: "$.stations { id }"})
  checkedQuake: Quake @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "latest_event"}, selection: "id magnitude", errors: {message: "$(result.content->first.text ?? error.message)", extensions: "code: $('QUAKE_TOOL_FAILED')"}})
}

type Quake @join__type(graph: QUAKES, key: "id") {
  id: ID!
  magnitude: Float
}

type Station @join__type(graph: QUAKES, key: "id") @join__directive(name: "connect", graphs: [QUAKES], args: {source: "quakes", mcp: {tool: "get_stations", arguments: "ids: $batch.id"}, selection: "$.stations { id name }"}) {
  id: ID!
  name: String
}
