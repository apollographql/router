---
source: apollo-router/src/plugins/telemetry/config_new/instruments.rs
description: Custom counter should be incremented on timeout error with operation_name attribute
expression: "&metrics.all()"
info:
  telemetry:
    instrumentation:
      instruments:
        router:
          http.server.active_requests: false
          http.server.request.duration: false
          http.server.request.timeout:
            type: counter
            value: unit
            description: request in timeout
            unit: request
            attributes:
              graphql.operation.name:
                response_context: "apollo::supergraph::operation_name"
            condition:
              eq:
                - request timed out
                - error: reason
---
- name: http.server.request.time_to_first_response
  description: Time from HTTP server request start to the first response byte.
  unit: s
  data:
    datapoints:
      - sum: 0.1
        count: 1
        attributes:
          error.type: Internal Server Error
          http.request.method: POST
          http.response.status_code: 500
      - sum: 0.1
        count: 1
        attributes:
          http.request.method: POST
- name: http.server.request.timeout
  description: request in timeout
  unit: request
  data:
    datapoints:
      - value: 1
        attributes:
          graphql.operation.name: TestQuery
