---
source: apollo-router/src/plugins/telemetry/config_new/instruments.rs
description: Custom histogram should not be incremented as the condition is not true on drop.
expression: "&metrics.all()"
info:
  telemetry:
    instrumentation:
      instruments:
        router:
          http.server.active_requests: false
          http.server.request.duration: false
          custom.histogram.duration:
            description: histogram of requests
            type: histogram
            unit: unit
            value: duration
            condition:
              eq:
                - response_header: never-true
                - "true"
---
- name: http.server.request.time_to_first_response
  description: Time from HTTP server request start to the first response byte.
  unit: s
  data:
    datapoints:
      - sum: 0.1
        count: 1
        attributes:
          http.request.method: GET
