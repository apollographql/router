---
source: apollo-router/src/plugins/telemetry/config_new/instruments.rs
description: Custom counter where the router response does not happen. This should still increment the metric on Drop.
expression: "&metrics.all()"
info:
  telemetry:
    instrumentation:
      instruments:
        router:
          http.server.active_requests: false
          http.server.request.duration: false
          custom_counter:
            description: count of requests
            type: counter
            unit: unit
            value: unit
---
- name: custom_counter
  description: count of requests
  unit: unit
  data:
    datapoints:
      - value: 1
        attributes: {}
- name: http.server.request.time_to_first_response
  description: Time from HTTP server request start to the first response byte.
  unit: s
  data:
    datapoints:
      - sum: 0.1
        count: 1
        attributes:
          http.request.method: GET
